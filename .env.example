# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Main process transport: http | stdio. The --stdio CLI flag overrides this.
MCP_TRANSPORT=http

# Postgres connection string. Required in production. When unset, development and
# test runs use an embedded Postgres (PGlite) with no external service.
# DATABASE_URL=postgres://user:password@localhost:5432/doordash_mcp
# PGLITE_DATA_DIR=.data/pglite

# MCP client authorization: dev | oidc
AUTH_MODE=dev
# MCP_ISSUER_URL=http://127.0.0.1:8080
# MCP_RESOURCE_URL=http://127.0.0.1:8080/mcp
# OIDC_ISSUER_URL=https://your-issuer.example.com/
# OIDC_AUDIENCE=https://your-mcp-server.example.com/mcp
# OIDC_TENANT_CLAIM=tenant_id
# OIDC_SUBJECT_CLAIM=sub
# OIDC_SCOPE_CLAIM=scope

# Local development identity (used by dev auth mode and stdio transport)
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_TENANT_NAME=Development Tenant
DEV_USER_ID=dev-user

# DoorDash Drive service-to-service credentials (server side only)
DOORDASH_ENVIRONMENT=sandbox
DOORDASH_DEVELOPER_ID=replace-with-developer-id
DOORDASH_KEY_ID=replace-with-key-id
DOORDASH_SIGNING_SECRET=replace-with-signing-secret
DOORDASH_API_BASE_URL=https://openapi.doordash.com/drive/v2
DOORDASH_API_TIMEOUT_MS=5000
DOORDASH_API_MAX_RETRIES=2

# DoorDash webhook authentication: basic | oauth
DOORDASH_WEBHOOK_AUTH_MODE=basic
# Basic mode: the full expected Authorization header value configured in the DoorDash portal.
DOORDASH_WEBHOOK_BASIC_AUTH=replace-with-expected-authorization-header
# OAuth mode: DoorDash uses these credentials against POST /webhooks/oauth/token.
# DOORDASH_WEBHOOK_OAUTH_CLIENT_ID=doordash-webhooks
# DOORDASH_WEBHOOK_OAUTH_CLIENT_SECRET=replace-with-random-client-secret
# OAuth access token lifetime in seconds.
DOORDASH_WEBHOOK_OAUTH_TOKEN_TTL_SECONDS=300
# Maximum accepted age of a webhook event timestamp (seconds).
DOORDASH_WEBHOOK_TOLERANCE_SECONDS=86400

# Optional base64-encoded 32-byte key for hashing/encrypting provider identifiers at rest.
# Required in production.
# DATABASE_ENCRYPTION_KEY=

LOG_LEVEL=info
RATE_LIMIT_TOOL_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
STATUS_DELAYED_AFTER_SECONDS=180
STATUS_STALE_AFTER_SECONDS=900
RECENT_DELIVERED_WINDOW_HOURS=24
