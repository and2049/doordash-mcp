{
  "name": "doordash-mcp",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Local consumer DoorDash MCP server with secure browser sessions, cart management, and ordering.",
  "type": "module",
  "bin": {
    "doordash-mcp": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist/**/*.js",
    "docs/*.md",
    "SECURITY.md",
    "THREAT_MODEL.md"
  ],
  "os": ["win32"],
  "keywords": ["mcp", "doordash", "agents", "chrome"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/and2049/doordash-mcp.git"
  },
  "homepage": "https://github.com/and2049/doordash-mcp#readme",
  "bugs": "https://github.com/and2049/doordash-mcp/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "consumer:status": "tsx src/cli.ts status",
    "consumer:disconnect": "tsx src/cli.ts disconnect",
    "consumer:reset-profile": "tsx src/cli.ts reset-profile",
    "consumer:attach": "tsx src/cli.ts attach",
    "consumer:mcp": "tsx src/cli.ts serve",
    "consumer:verify": "tsx src/cli.ts verify",
    "consumer:test-reads": "tsx scripts/verify-consumer-tools.ts",
    "consumer:test-cart": "tsx scripts/verify-consumer-cart-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
