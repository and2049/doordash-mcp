{
  "name": "doordash-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local consumer DoorDash MCP server with secure browser sessions, cart management, and ordering.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "simulate:webhook": "tsx scripts/simulate-webhook.ts",
    "consumer:connect": "tsx scripts/consumer-session.ts connect",
    "consumer:open": "tsx scripts/consumer-session.ts open",
    "consumer:status": "tsx scripts/consumer-session.ts status",
    "consumer:disconnect": "tsx scripts/consumer-session.ts disconnect",
    "consumer:persistent": "tsx scripts/consumer-session.ts persistent",
    "consumer:reset-profile": "tsx scripts/consumer-session.ts reset-profile",
    "consumer:attach": "tsx scripts/consumer-session.ts attach",
    "consumer:mcp": "tsx src/consumer/index.ts",
    "consumer:verify": "tsx scripts/consumer-session.ts verify",
    "consumer:test-reads": "tsx scripts/verify-consumer-tools.ts",
    "consumer:test-cart": "tsx scripts/verify-consumer-cart-tools.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
